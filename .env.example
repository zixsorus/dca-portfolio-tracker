# DCA Portfolio Tracker — environment variables (template, no secrets here)
# Local dev:  cp .env.example .env
# Vercel:     set these in Project Settings → Environment Variables instead.

# --- Database (Turso / libsql) ---
# Local dev: a SQLite file is enough (no token needed).
# `npm run dev` creates ./local.db and seeds your portfolio data on first run.
TURSO_DATABASE_URL=file:./local.db

# Production (Turso cloud, https://turso.tech) — fill in when deploying:
# TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=<your-turso-auth-token>

# --- Market prices (Finnhub, free tier at https://finnhub.io) ---
# Optional for local dev (only needed for "ดึงราคาล่าสุด" / price refresh).
# Required on Vercel for price refresh to work.
FINNHUB_API_KEY=
