    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.48.0",
    "react": "19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "tailwind-merge": "^3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
