  },
  "engines": {
    "node": ">=20"
  },
  "name": "dca-portfolio-tracker",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build:client",
    "build:client": "vite build -c client/vite.config.ts",
